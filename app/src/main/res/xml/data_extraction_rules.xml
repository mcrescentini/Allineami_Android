<?xml version="1.0" encoding="utf-8"?>
<!-- No Google Drive backup; data is copied only in direct device-to-device transfers -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="allineami_rl7c.xml" />
    </device-transfer>
</data-extraction-rules>
